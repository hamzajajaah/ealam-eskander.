<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EALAM ESKANDER | عالم اسكندر</title>
<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Aref Ruqaa',serif}
body{background:#0a0505;color:#fff;overflow-x:hidden}
a{text-decoration:none;color:inherit}
/* LOGIN */
#loginPage{position:fixed;inset:0;background:radial-gradient(circle at top,#3a0a0a,#0a0505 70%);display:flex;align-items:center;justify-content:center;z-index:100;padding:20px}
.login-box{background:rgba(255,255,255,.06);border:1px solid rgba(255,80,80,.4);padding:30px;border-radius:20px;width:100%;max-width:380px;text-align:center;backdrop-filter:blur(10px);box-shadow:0 0 40px rgba(255,0,0,.25)}
.login-box h1{font-size:42px;color:#ff6b6b}
.login-box p{opacity:.8;margin:8px 0 20px;font-size:19px}
.login-box input{width:100%;padding:13px;margin:7px 0;border-radius:12px;border:1px solid #444;background:#160a0a;color:#fff;font-size:18px;outline:none;text-align:center}
.login-box button{width:100%;padding:13px;background:#c22a2a;border:none;border-radius:12px;color:#fff;font-size:22px;cursor:pointer;margin-top:10px}
.login-box button:hover{background:#e03131}
.login-box small{display:block;margin-top:12px;opacity:.6}
/* SITE */
#site{display:none}
header{padding:14px 18px;display:flex;justify-content:space-between;align-items:center;background:rgba(0,0,0,.6);border-bottom:1px solid #3a1111;position:sticky;top:0;z-index:10}
header b{font-size:26px;color:#ff6b6b}
header span{background:#c22a2a;padding:6px 14px;border-radius:20px;font-size:16px}
.hero{text-align:center;padding:35px 15px 10px;background:linear-gradient(180deg,#2a0808,transparent)}
.hero h1{font-size:44px;color:#ff6b6b;line-height:1.2}
.hero p{font-size:21px;opacity:.9;margin-top:8px}
.hero .badges{margin-top:14px;display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.hero .badges span{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);padding:6px 14px;border-radius:20px;font-size:16px}
.clock-box{margin:18px auto;max-width:420px;background:#180808;border:1px solid #ff4d4d66;border-radius:18px;padding:14px;text-align:center}
.clock-box b{font-size:36px;color:#ffb3b3;letter-spacing:1px}
.clock-box small{display:block;opacity:.7;font-size:17px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:18px;max-width:1150px;margin:auto}
@media(max-width:850px){.grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.grid{grid-template-columns:1fr 1fr}.hero h1{font-size:34px}}
.card{border-radius:18px;overflow:hidden;background:#171010;border:1px solid #2b1a1a;display:flex;flex-direction:column}
.banner{height:105px;display:flex;align-items:center;justify-content:center;font-size:40px}
.card-body{padding:13px;text-align:center}
.card-body h3{font-size:24px;margin-bottom:4px}
.card-body p{font-size:17px;opacity:.8;line-height:1.4;min-height:48px}
.price{margin:8px 0;font-size:20px;color:#ffb3b3}
.btn{display:block;background:#c22a2a;padding:10px;border-radius:11px;font-size:19px;margin-top:8px}
.btn.green{background:#1faa59}.btn.blue{background:#1e7ad1}.btn.gold{background:#c9971f;color:#000}.btn.dark{background:#222}
.free-tag{display:inline-block;background:#1faa59;padding:3px 10px;border-radius:10px;font-size:15px}
.paid-tag{display:inline-block;background:#c9971f;color:#000;padding:3px 10px;border-radius:10px;font-size:15px;font-weight:bold}
.contact{max-width:1150px;margin:10px auto 30px;padding:0 18px}
.contact-box{background:linear-gradient(135deg,#2a0a0a,#120505);border:1px solid #ff4d4d55;border-radius:18px;padding:20px;text-align:center}
.contact-box h2{font-size:30px;color:#ff6b6b}
footer{text-align:center;padding:18px;opacity:.6;font-size:16px}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="loginPage">
  <div class="login-box">
    <h1>عالم اسكندر</h1>
    <p>الأمن السيبراني مش رفاهية .. دي حماية لحياتك<br>احمي نفسك قبل ما تُخترق</p>
    <input id="uName" placeholder="اسمك">
    <input id="uPhone" placeholder="رقم الواتساب">
    <input id="uPass" type="password" placeholder="كلمة السر">
    <button onclick="login()">دخول للموقع 🔥</button>
